# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=production
# Long random value. Production will not start with a placeholder.
SECRET_KEY=your-secret-key-here
# Dedicated Fernet secret for AI API keys at rest. Set this BEFORE rotating SECRET_KEY,
# then run: python scripts/security/reencrypt_ai_keys.py
# AI_KEY_ENCRYPTION_SECRET=
# Do not put OPENAI_API_KEY here — store keys in Admin → AI Settings.

# HTTPS production: set true so the session cookie is never sent over HTTP.
SESSION_COOKIE_SECURE=true

# Idle session lifetime in hours (1–24). Active use refreshes the cookie.
SESSION_LIFETIME_HOURS=12

# CSRF enforcement. Production defaults to true (CPANEL/FLASK_ENV=production).
CSRF_ENABLED=true

# Reverse proxy (cPanel Apache): trust 1 X-Forwarded-For hop. Set 0 to ignore the header.
# TRUST_PROXY_HOPS=1

# Socket.IO browser origins. Default: PUBLIC_APP_URL + tenant public_url (not *).
# Comma-separated override, or * only as an emergency.
# SOCKETIO_CORS_ORIGINS=https://kulawams.xyz,https://www.kulawams.xyz

# Tenant / discipline (law | mcj | ...). Default law keeps current branding.
TENANT_CODE=law
# Optional: override Passenger virtualenv activate script (MCJ uses its own venv)
# VIRTUALENV_ACTIVATE=/home/USER/virtualenv/mcj.example.com/3.12/bin/activate_this.py
# Public site URL (no trailing slash). Used for emails and Socket.IO CORS.
# PUBLIC_APP_URL=https://kulawams.xyz
# DOMAIN=kulawams.xyz

# Database Configuration
DATABASE_URL=sqlite:///academic_management.db

# =============================================================================
# Dual mailbox (Hosting Bangladesh SMTP) — kulawams.xyz
# Create recovery@ and noreply@ in cPanel → Email Accounts.
# Set these in Python App → Environment variables, then SAVE + Restart.
#
# Host guidance:
#   Host: server.hostingbangladesh.com
#   Port: 465
#   Encryption: SSL/TLS
#   Username = From address (same mailbox)
# =============================================================================

# --- Password recovery: recovery@kulawams.xyz ---
MAIL_SERVER=server.hostingbangladesh.com
MAIL_PORT=465
MAIL_USE_TLS=False
MAIL_USE_SSL=True
# TLS certificate check (1.12). Keep true in production.
# If password-reset mail fails with CERTIFICATE_VERIFY_FAILED, set false only as a temporary override,
# or pin the host cert: MAIL_SSL_FINGERPRINT=<sha256 hex of the SMTP cert>
MAIL_SSL_VERIFY=true
# MAIL_SSL_FINGERPRINT=
# Local sendmail fallback is off unless explicitly enabled.
MAIL_USE_SENDMAIL=false
MAIL_USERNAME=recovery@kulawams.xyz
MAIL_PASSWORD=your-recovery-mailbox-password
MAIL_DEFAULT_SENDER=recovery@kulawams.xyz
# Leave MAIL_FROM_NAME empty so From == Username (host requirement)
# MAIL_FROM_NAME=

# --- Notifications: noreply@kulawams.xyz ---
NOTIFICATION_MAIL_SERVER=server.hostingbangladesh.com
NOTIFICATION_MAIL_PORT=465
NOTIFICATION_MAIL_USE_TLS=False
NOTIFICATION_MAIL_USE_SSL=True
NOTIFICATION_MAIL_USERNAME=noreply@kulawams.xyz
NOTIFICATION_MAIL_PASSWORD=your-noreply-mailbox-password
NOTIFICATION_MAIL_SENDER=noreply@kulawams.xyz
# NOTIFICATION_MAIL_FROM_NAME=

# Environment Variables
CPANEL=1
RENDER=0

# Application Settings
# Private uploads (photos, signatures, admission files) — OUTSIDE public_html.
# cPanel example: /home/kulawams/ams_private_uploads
# Default if unset: ~/ams_private_uploads
PRIVATE_UPLOAD_DIR=/home/kulawams/ams_private_uploads
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216
