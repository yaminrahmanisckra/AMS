# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=production
SECRET_KEY=your-secret-key-here

# Database Configuration
DATABASE_URL=sqlite:///academic_management.db

# Email Configuration — password recovery (MAIL_*)
# Option A: Brevo SMTP (recommended if host blocks outbound SMTP)
#   MAIL_SERVER=smtp-relay.brevo.com
#   MAIL_PORT=587
#   MAIL_USE_TLS=True
#   MAIL_USE_SSL=False
#   MAIL_USERNAME=xxxx@smtp-brevo.com   # from Brevo → Settings → SMTP & API (NOT account email)
#   MAIL_PASSWORD=<SMTP key>            # SMTP key only — NOT account password, NOT API key
#   MAIL_DEFAULT_SENDER=recovery@yourdomain.com  # verified sender / domain in Brevo
#
# Option B: Gmail SMTP
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
# For cPanel localhost relay (port 25): set MAIL_USE_TLS=False and MAIL_USE_SSL=False
MAIL_USE_SSL=False
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# Notification emails (marks revealed, etc.) — separate mailbox from password recovery
# For Brevo: USERNAME = xxx@smtp-brevo.com, SENDER = noreply@yourdomain.com
NOTIFICATION_MAIL_SERVER=localhost
NOTIFICATION_MAIL_PORT=25
NOTIFICATION_MAIL_USE_TLS=False
NOTIFICATION_MAIL_USE_SSL=False
NOTIFICATION_MAIL_USERNAME=noreply@example.com
NOTIFICATION_MAIL_PASSWORD=your-noreply-password
NOTIFICATION_MAIL_SENDER=noreply@example.com

# Environment Variables
CPANEL=1
RENDER=0

# Application Settings
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216 