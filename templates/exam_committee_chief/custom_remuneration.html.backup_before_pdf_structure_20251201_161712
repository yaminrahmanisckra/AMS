// Save form function
function saveForm() {
    console.log('🚀 saveForm() called - Using simplified save method');
    
    // First, save to localStorage as backup
    try {
        const formData = collectFormData();
        localStorage.setItem('custom_remuneration_draft', JSON.stringify(formData));
        localStorage.setItem('custom_remuneration_draft_timestamp', new Date().toISOString());
        console.log('✅ Data saved to localStorage as backup');
    } catch (error) {
        console.error('❌ Error saving to localStorage:', error);
    }
    
    // Collect form data
    let formData;
    try {
        formData = collectFormData();
        console.log('📝 Form data collected');
    } catch (error) {
        console.error('❌ Error in collectFormData():', error);
        alert('❌ Error collecting form data: ' + error.message);
        return;
    }
    
    // Show loading indicator
    const saveBtn = document.querySelector('button[onclick="saveForm()"]');
    if (!saveBtn) {
        console.error('❌ Save button not found!');
        alert('❌ Save button not found. Please refresh the page.');
        return;
    }
    
    const originalText = saveBtn.innerHTML;
    saveBtn.disabled = true;
    saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Saving...';
    
    // Submit using fetch
    fetch('/exam-committee-chief/custom-remuneration/save-simple', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
        },
        body: new URLSearchParams({
            'form_data': JSON.stringify(formData),
            'form_id': document.getElementById('form_id')?.value || ''
        })
    })
    .then(response => response.json())
    .then(data => {
        saveBtn.disabled = false;
        saveBtn.innerHTML = originalText;
        
        if (data.success) {
            console.log('✅ Save successful! Form ID:', data.form_id);
            alert('✅ Form saved successfully! Form ID: ' + (data.form_id || 'N/A'));
            
            // Store form_id
            if (data.form_id) {
                let formIdElement = document.getElementById('form_id');
                if (!formIdElement) {
                    formIdElement = document.createElement('input');
                    formIdElement.type = 'hidden';
                    formIdElement.id = 'form_id';
                    formIdElement.name = 'form_id';
                    const container = document.querySelector('.remuneration-form-container') || document.body;
                    container.appendChild(formIdElement);
                }
                formIdElement.value = data.form_id;
                
                // Update URL
                const newUrl = `/exam-committee-chief/custom-remuneration/${data.form_id}`;
                window.history.replaceState({}, '', newUrl);
                console.log('✅ URL updated to:', newUrl);
            }
            
            // Clear localStorage backup after successful save
            localStorage.removeItem('custom_remuneration_draft');
            localStorage.removeItem('custom_remuneration_draft_timestamp');
        } else {
            throw new Error(data.message || 'Save failed');
        }
    })
    .catch(error => {
        saveBtn.disabled = false;
        saveBtn.innerHTML = originalText;
        console.error('❌ Error saving form:', error);
        alert('❌ Error saving form: ' + error.message + '\n\nNote: Your data has been saved to browser storage as backup.');
    });
}

