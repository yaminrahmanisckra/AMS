<script>
// Store teachers data for JavaScript
const teachersData = {{ teachers_data|tojson }};
const curriculumConfigs = {{ curriculum_configs|tojson }};

// Generic remove row function
function removeRow(btn) {
    if (confirm('Remove this row?')) {
        btn.closest('tr').remove();
    }
}

// Generic add row function
function addRow(tableId, columnTypes) {
    const table = document.getElementById(tableId);
    const tbody = table.querySelector('tbody');
    const newRow = document.createElement('tr');
    
    columnTypes.forEach((type, index) => {
        const td = document.createElement('td');
        if (type === 'text') {
            td.innerHTML = '<input type="text" class="form-control form-control-sm">';
        } else if (type === 'number') {
            td.innerHTML = '<input type="number" class="form-control form-control-sm" value="0" min="0">';
        } else if (type === 'action') {
            td.innerHTML = '<button type="button" class="btn btn-remove-row" onclick="removeRow(this)"><i class="fas fa-times"></i></button>';
        }
        newRow.appendChild(td);
    });
    
    tbody.appendChild(newRow);
}

// Fetch courses based on session, year, term
async function fetchCourses() {
    const session = document.getElementById('session').value;
    const year = document.getElementById('year').value;
    const term = document.getElementById('term').value;
    
    if (!session || !year || !term) {
        return [];
    }
    
    try {
        // Use the existing remuneration API endpoint
        const response = await fetch(`/remuneration/api/courses?academic_session=${encodeURIComponent(session)}&year=${encodeURIComponent(year)}&term=${encodeURIComponent(term)}`);
        const data = await response.json();
        if (data.success) {
            return data.courses || [];
        }
        return [];
    } catch (error) {
        console.error('Error fetching courses:', error);
        return [];
    }
}

// Fetch sessional courses (same as regular courses but filtered for sessional type)
async function fetchSessionalCourses() {
    const session = document.getElementById('session').value;
    const year = document.getElementById('year').value;
    const term = document.getElementById('term').value;
    
    if (!session || !year || !term) {
        return [];
    }
    
    try {
        // Use the existing remuneration API endpoint
        const response = await fetch(`/remuneration/api/courses?academic_session=${encodeURIComponent(session)}&year=${encodeURIComponent(year)}&term=${encodeURIComponent(term)}`);
        const data = await response.json();
        if (data.success) {
            // Filter for sessional courses (course_type contains 'Sessional' or category is 'Sessional')
            const sessionalCourses = (data.courses || []).filter(c => {
                const courseType = (c.course_type || '').toLowerCase();
                const category = (c.category || '').toLowerCase();
                return courseType.includes('sessional') || category.includes('sessional');
            });
            return sessionalCourses;
        }
        return [];
    } catch (error) {
        console.error('Error fetching sessional courses:', error);
        return [];
    }
}

// Load courses into select element
function loadCoursesIntoSelect(selectElement, courses, selectedValue = '') {
    selectElement.innerHTML = '<option value="">Select Course</option>';
    courses.forEach(course => {
        const option = document.createElement('option');
        const courseText = `${course.course_code} - ${course.course_name}`;
        option.value = courseText;
        option.textContent = courseText;
        if (selectedValue === courseText || selectedValue === course.course_code) {
            option.selected = true;
        }
        selectElement.appendChild(option);
    });
}

// Auto-load courses when session/year/term changes
document.getElementById('session')?.addEventListener('change', async function() {
    await autoLoadCoursesForTables();
});

document.getElementById('year')?.addEventListener('change', async function() {
    await autoLoadCoursesForTables();
});

document.getElementById('term')?.addEventListener('change', async function() {
    await autoLoadCoursesForTables();
});

// Auto-load courses for all course select elements
async function autoLoadCoursesForTables() {
    const courses = await fetchCourses();
    const sessionalCourses = await fetchSessionalCourses();
    
    // Load regular courses
    document.querySelectorAll('.course-select').forEach(select => {
        loadCoursesIntoSelect(select, courses);
    });
    
    // Load sessional courses
    document.querySelectorAll('.sessional-course-select').forEach(select => {
        loadCoursesIntoSelect(select, sessionalCourses);
    });
}

// On course change for question preparation
function onCourseChange(selectElement) {
    // Can add specific logic here if needed
}

// On class test course change
async function onClassTestCourseChange(selectElement) {
    const row = selectElement.closest('tr');
    const sectionInput = row.querySelector('input[name="class_test_section[]"]');
    const classTestInput = row.querySelector('input[name="class_test_no[]"]');
    const studentsInput = row.querySelector('input[name="class_test_students[]"]');
    
    updateClassTestCount(sectionInput);
    
    // Fetch student count
    if (selectElement.value) {
        await fetchStudentCountForClassTest(selectElement, studentsInput);
    } else {
        studentsInput.value = '0';
    }
}

// Update class test count based on section
function updateClassTestCount(sectionInput) {
    const row = sectionInput.closest('tr');
    const classTestInput = row.querySelector('input[name="class_test_no[]"]');
    const section = sectionInput.value.trim().toUpperCase();
    
    if (section === 'A' || section === 'B') {
        classTestInput.value = '2';
    } else if (section === 'FULL' || section === '') {
        classTestInput.value = '4';
    } else {
        classTestInput.value = '0';
    }
}

// Fetch student count for class test
async function fetchStudentCountForClassTest(courseSelect, studentsInput) {
    const session = document.getElementById('session').value;
    const year = document.getElementById('year').value;
    const term = document.getElementById('term').value;
    const courseCode = courseSelect.value.split(' - ')[0];
    const section = courseSelect.closest('tr').querySelector('input[name="class_test_section[]"]').value;
    
    if (!session || !year || !term || !courseCode) {
        studentsInput.value = '0';
        return;
    }
    
    try {
        const url = `/remuneration/api/student-count?course_code=${encodeURIComponent(courseCode)}&academic_session=${encodeURIComponent(session)}&year=${encodeURIComponent(year)}&term=${encodeURIComponent(term)}`;
        const response = await fetch(url);
        const data = await response.json();
        studentsInput.value = data.success ? (data.student_count || '0') : '0';
    } catch (error) {
        console.error('Error fetching student count:', error);
        studentsInput.value = '0';
    }
}

// On sessional course change
async function onSessionalCourseChange(selectElement, tableType) {
    const row = selectElement.closest('tr');
    const studentsInput = row.querySelector('input[type="number"]');
    
    if (!selectElement.value) {
        studentsInput.value = '0';
        return;
    }
    
    const session = document.getElementById('session').value;
    const year = document.getElementById('year').value;
    const term = document.getElementById('term').value;
    const courseCode = selectElement.value.split(' - ')[0];
    
    if (!session || !year || !term || !courseCode) {
        studentsInput.value = '0';
        return;
    }
    
    try {
        const url = `/remuneration/api/student-count?course_code=${encodeURIComponent(courseCode)}&academic_session=${encodeURIComponent(session)}&year=${encodeURIComponent(year)}&term=${encodeURIComponent(term)}`;
        const response = await fetch(url);
        const data = await response.json();
        studentsInput.value = data.success ? (data.student_count || '0') : '0';
    } catch (error) {
        console.error('Error fetching student count:', error);
        studentsInput.value = '0';
    }
}

// On moderation committee name change
function onModerationNameChange(selectElement) {
    const row = selectElement.closest('tr');
    const designationInput = row.querySelector('input[name="moderation_committee_designation[]"]');
    const teacherName = selectElement.value;
    
    const teacher = teachersData.find(t => t.name === teacherName);
    if (teacher) {
        designationInput.value = `${teacher.designation || ''}, ${teacher.institute || 'Law Discipline, KU'}`.replace(/^,\s*|,\s*$/g, '');
    }
}

