{% extends "base.html" %}

{% block title %}Custom Remuneration Form{% endblock %}

{% block extra_css %}
<style>
    .remuneration-form-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 20px;
    }
    .form-header {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 8px;
        margin-bottom: 30px;
    }
    .section-container {
        margin-bottom: 30px;
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 20px;
        background: white;
    }
    .section-title {
        font-size: 16px;
        font-weight: bold;
        margin-bottom: 15px;
        color: #333;
        border-bottom: 2px solid #007bff;
        padding-bottom: 5px;
    }
    table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 15px;
    }
    table th, table td {
        border: 1px solid #ddd;
        padding: 8px;
        text-align: left;
    }
    table th {
        background-color: #f8f9fa;
        font-weight: bold;
        text-align: center;
    }
    .btn-add-row {
        margin-top: 10px;
    }
    .btn-remove-row {
        color: #dc3545;
        background: none;
        border: none;
        cursor: pointer;
    }
    .btn-remove-row:hover {
        color: #c82333;
    }
</style>
{% endblock %}

{% block content %}
<div class="remuneration-form-container">
    <div class="form-header">
        <h2 class="mb-4">Statement on Remuneration</h2>
        
        <input type="hidden" id="form_id" name="form_id" value="{{ saved_data.form_id if saved_data else '' }}">
        
        <div class="row mb-3">
            <div class="col-md-3">
                <label class="form-label">Program</label>
                <input type="text" class="form-control" id="program" name="program" value="{{ saved_data.program if saved_data else 'LL.B. (Hons.)' }}">
            </div>
            <div class="col-md-3">
                <label class="form-label">Academic Session</label>
                <select class="form-select" id="session" name="session" required>
                    <option value="">Select Session</option>
                    {% for session in academic_sessions %}
                    <option value="{{ session }}" {% if saved_data and saved_data.session == session or (not saved_data and current_session == session) %}selected{% endif %}>{{ session }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Year</label>
                <select class="form-select" id="year" name="year" required>
                    <option value="">Select Year</option>
                    {% for y in unique_years %}
                    <option value="{{ y }}" {% if saved_data and saved_data.year == y|string or (not saved_data and current_year == y) %}selected{% endif %}>{{ y }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Term</label>
                <select class="form-select" id="term" name="term" required>
                    <option value="">Select Term</option>
                    {% for t in unique_terms %}
                    <option value="{{ t }}" {% if saved_data and saved_data.term == t|string or (not saved_data and current_term == t) %}selected{% endif %}>{{ t }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Batch</label>
                <select class="form-select" id="batch" name="batch">
                    <option value="">Select Batch</option>
                    {% for b in unique_batches %}
                    <option value="{{ b }}" {% if saved_data and saved_data.batch == b|string or (not saved_data and current_batch == b) %}selected{% endif %}>{{ b }}</option>
                    {% endfor %}
                </select>
            </div>
        </div>
        
        <div class="row mb-3">
            <div class="col-md-4">
                <label class="form-label">Total Amount</label>
                <input type="text" class="form-control" id="total_amount" name="total_amount" value="{{ saved_data.total_amount if saved_data else '' }}" placeholder="0.00">
            </div>
            <div class="col-md-4">
                <label class="form-label">Total in Words</label>
                <input type="text" class="form-control" id="total_in_words" name="total_in_words" value="{{ saved_data.total_in_words if saved_data else '' }}" placeholder="Taka ... only">
            </div>
            <div class="col-md-2">
                <label class="form-label">Chief Name</label>
                <input type="text" class="form-control" id="chief_name" name="chief_name" value="{{ saved_data.chief_name if saved_data else '' }}">
            </div>
            <div class="col-md-2">
                <label class="form-label">Chief Title</label>
                <input type="text" class="form-control" id="chief_title" name="chief_title" value="{{ saved_data.chief_title if saved_data else 'Head' }}">
            </div>
        </div>
    </div>
    
    <!-- Section 1: Examination Committee -->
    <div class="section-container">
        <div class="section-title">1. Examination Committee</div>
        <table id="table_examination_committee">
            <thead>
                <tr>
                    <th style="width: 40%;">Name</th>
                    <th style="width: 35%;">Designation/Institute</th>
                    <th style="width: 20%;">Position</th>
                    <th style="width: 5%;">Action</th>
                </tr>
            </thead>
            <tbody>
                {% if saved_data and saved_data.examination_committee %}
                    {% for member in saved_data.examination_committee %}
                    <tr>
                        <td><input type="text" class="form-control form-control-sm" name="examination_committee_name[]" value="{{ member.name or '' }}"></td>
                        <td><input type="text" class="form-control form-control-sm" name="examination_committee_designation[]" value="{{ member.designation or '' }}"></td>
                        <td><input type="text" class="form-control form-control-sm" name="examination_committee_position[]" value="{{ member.position or '' }}"></td>
                        <td><button type="button" class="btn btn-remove-row" onclick="removeRow(this)"><i class="fas fa-times"></i></button></td>
                    </tr>
                    {% endfor %}
                {% elif examination_committee %}
                    {% for member in examination_committee %}
                    <tr>
                        <td><input type="text" class="form-control form-control-sm" name="examination_committee_name[]" value="{{ member.name or '' }}"></td>
                        <td><input type="text" class="form-control form-control-sm" name="examination_committee_designation[]" value="{{ member.designation or '' }}"></td>
                        <td><input type="text" class="form-control form-control-sm" name="examination_committee_position[]" value="{{ member.position or '' }}"></td>
                        <td><button type="button" class="btn btn-remove-row" onclick="removeRow(this)"><i class="fas fa-times"></i></button></td>
                    </tr>
                    {% endfor %}
                {% else %}
                    <tr>
                        <td><input type="text" class="form-control form-control-sm" name="examination_committee_name[]"></td>
                        <td><input type="text" class="form-control form-control-sm" name="examination_committee_designation[]"></td>
                        <td><input type="text" class="form-control form-control-sm" name="examination_committee_position[]"></td>
                        <td><button type="button" class="btn btn-remove-row" onclick="removeRow(this)"><i class="fas fa-times"></i></button></td>
                    </tr>
                {% endif %}
            </tbody>
        </table>
        <button type="button" class="btn btn-sm btn-primary btn-add-row" onclick="addRow('table_examination_committee', ['text', 'text', 'text', 'action'])">Add Row</button>
    </div>
    
    <!-- Section 2: Question Preparation -->
    <div class="section-container">
        <div class="section-title">2. Question Preparation</div>
        <table id="table_question_preparation">
            <thead>
                <tr>
                    <th>Course No.</th>
                    <th>Section</th>
                    <th>Name of Question Setter</th>
                    <th>Designation/Institute</th>
                    <th>No. of Questions</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                {% if saved_data and saved_data.question_preparation %}
                    {% for item in saved_data.question_preparation %}
                    <tr>
                        <td>
                            <select class="form-select form-select-sm course-select" name="question_preparation_course[]" onchange="onCourseChange(this)">
                                <option value="">Select Course</option>
                                <!-- Courses will be loaded dynamically -->
                            </select>
                        </td>
                        <td><input type="text" class="form-control form-control-sm" name="question_preparation_section[]" value="{{ item.section or '' }}" placeholder="A/B/Full"></td>
                        <td><input type="text" class="form-control form-control-sm" name="question_preparation_teacher[]" value="{{ item.teacher or '' }}"></td>
                        <td><input type="text" class="form-control form-control-sm" name="question_preparation_designation[]" value="{{ item.designation or '' }}"></td>
                        <td><input type="number" class="form-control form-control-sm" name="question_preparation_questions[]" value="{{ item.questions or '1' }}" min="1"></td>
                        <td><button type="button" class="btn btn-remove-row" onclick="removeRow(this)"><i class="fas fa-times"></i></button></td>
                    </tr>
                    {% endfor %}
                {% else %}
                    <tr>
                        <td>
                            <select class="form-select form-select-sm course-select" name="question_preparation_course[]" onchange="onCourseChange(this)">
                                <option value="">Select Course</option>
                                <!-- Courses will be loaded dynamically -->
                            </select>
                        </td>
                        <td><input type="text" class="form-control form-control-sm" name="question_preparation_section[]" placeholder="A/B/Full"></td>
                        <td><input type="text" class="form-control form-control-sm" name="question_preparation_teacher[]"></td>
                        <td><input type="text" class="form-control form-control-sm" name="question_preparation_designation[]"></td>
                        <td><input type="number" class="form-control form-control-sm" name="question_preparation_questions[]" value="1" min="1"></td>
                        <td><button type="button" class="btn btn-remove-row" onclick="removeRow(this)"><i class="fas fa-times"></i></button></td>
                    </tr>
                {% endif %}
            </tbody>
        </table>
        <button type="button" class="btn btn-sm btn-primary btn-add-row" onclick="addQuestionPreparationRow()">Add Row</button>
    </div>
    
    <!-- Section 3: Answer Script Examination -->
    <div class="section-container">
        <div class="section-title">3. Answer Script Examination</div>
        <table id="table_script_examination">
            <thead>
                <tr>
                    <th>Course No.</th>
                    <th>Section</th>
                    <th>Name of Examiner</th>
                    <th>Designation/Institute</th>
                    <th>No. of Scripts</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                {% if saved_data and saved_data.script_examination %}
                    {% for item in saved_data.script_examination %}
                    <tr>
                        <td>
                            <select class="form-select form-select-sm course-select" name="script_examination_course[]" onchange="onCourseChange(this)">
                                <option value="">Select Course</option>
                            </select>
                        </td>
                        <td><input type="text" class="form-control form-control-sm" name="script_examination_section[]" value="{{ item.section or '' }}" placeholder="A/B/Full"></td>
                        <td><input type="text" class="form-control form-control-sm" name="script_examination_teacher[]" value="{{ item.teacher or '' }}"></td>
                        <td><input type="text" class="form-control form-control-sm" name="script_examination_designation[]" value="{{ item.designation or '' }}"></td>
                        <td><input type="number" class="form-control form-control-sm" name="script_examination_scripts[]" value="{{ item.scripts or '0' }}" min="0"></td>
                        <td><button type="button" class="btn btn-remove-row" onclick="removeRow(this)"><i class="fas fa-times"></i></button></td>
                    </tr>
                    {% endfor %}
                {% else %}
                    <tr>
                        <td>
                            <select class="form-select form-select-sm course-select" name="script_examination_course[]" onchange="onCourseChange(this)">
                                <option value="">Select Course</option>
                            </select>
                        </td>
                        <td><input type="text" class="form-control form-control-sm" name="script_examination_section[]" placeholder="A/B/Full"></td>
                        <td><input type="text" class="form-control form-control-sm" name="script_examination_teacher[]"></td>
                        <td><input type="text" class="form-control form-control-sm" name="script_examination_designation[]"></td>
                        <td><input type="number" class="form-control form-control-sm" name="script_examination_scripts[]" value="0" min="0"></td>
                        <td><button type="button" class="btn btn-remove-row" onclick="removeRow(this)"><i class="fas fa-times"></i></button></td>
                    </tr>
                {% endif %}
            </tbody>
        </table>
        <button type="button" class="btn btn-sm btn-primary btn-add-row" onclick="addScriptExaminationRow()">Add Row</button>
    </div>
    
    <!-- Section 4: Class Test -->
    <div class="section-container">
        <div class="section-title">4. Class Test</div>
        <table id="table_class_test">
            <thead>
                <tr>
                    <th>Course No.</th>
                    <th>Section</th>
                    <th>Name of Course Teacher</th>
                    <th>Designation/Institute</th>
                    <th>No. of Class Tests</th>
                    <th>No. of Students</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                {% if saved_data and saved_data.class_test %}
                    {% for item in saved_data.class_test %}
                    <tr>
                        <td>
                            <select class="form-select form-select-sm course-select" name="class_test_course[]" onchange="onClassTestCourseChange(this)">
                                <option value="">Select Course</option>
                            </select>
                        </td>
                        <td><input type="text" class="form-control form-control-sm" name="class_test_section[]" value="{{ item.section or '' }}" placeholder="A/B/Full"></td>
                        <td><input type="text" class="form-control form-control-sm" name="class_test_teacher[]" value="{{ item.teacher or '' }}"></td>
                        <td><input type="text" class="form-control form-control-sm" name="class_test_designation[]" value="{{ item.designation or '' }}"></td>
                        <td><input type="number" class="form-control form-control-sm" name="class_test_no[]" value="{{ item.class_test or '0' }}" min="0" readonly></td>
                        <td><input type="number" class="form-control form-control-sm" name="class_test_students[]" value="{{ item.students or '0' }}" min="0" readonly></td>
                        <td><button type="button" class="btn btn-remove-row" onclick="removeRow(this)"><i class="fas fa-times"></i></button></td>
                    </tr>
                    {% endfor %}
                {% else %}
                    <tr>
                        <td>
                            <select class="form-select form-select-sm course-select" name="class_test_course[]" onchange="onClassTestCourseChange(this)">
                                <option value="">Select Course</option>
                            </select>
                        </td>
                        <td><input type="text" class="form-control form-control-sm" name="class_test_section[]" placeholder="A/B/Full" onchange="updateClassTestCount(this)"></td>
                        <td><input type="text" class="form-control form-control-sm" name="class_test_teacher[]"></td>
                        <td><input type="text" class="form-control form-control-sm" name="class_test_designation[]"></td>
                        <td><input type="number" class="form-control form-control-sm" name="class_test_no[]" value="0" min="0" readonly></td>
                        <td><input type="number" class="form-control form-control-sm" name="class_test_students[]" value="0" min="0" readonly></td>
                        <td><button type="button" class="btn btn-remove-row" onclick="removeRow(this)"><i class="fas fa-times"></i></button></td>
                    </tr>
                {% endif %}
            </tbody>
        </table>
        <button type="button" class="btn btn-sm btn-primary btn-add-row" onclick="addClassTestRow()">Add Row</button>
    </div>
    
    <!-- Section 5: Moderation Committee -->
    <div class="section-container">
        <div class="section-title">5. Moderation Committee</div>
        <table id="table_moderation_committee">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Designation/Institute</th>
                    <th>Position</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                {% if saved_data and saved_data.moderation_committee %}
                    {% for member in saved_data.moderation_committee %}
                    <tr>
                        <td>
                            <select class="form-select form-select-sm teacher-name-select" name="moderation_committee_name[]" onchange="onModerationNameChange(this)">
                                <option value="">Select Name</option>
                                {% for teacher in teachers %}
                                <option value="{{ teacher.name }}" {% if member.name == teacher.name %}selected{% endif %}>{{ teacher.name }}</option>
                                {% endfor %}
                            </select>
                        </td>
                        <td>
                            <input type="text" class="form-control form-control-sm" name="moderation_committee_designation[]" value="{{ member.designation or '' }}">
                        </td>
                        <td><input type="text" class="form-control form-control-sm" name="moderation_committee_position[]" value="{{ member.position or '' }}"></td>
                        <td><button type="button" class="btn btn-remove-row" onclick="removeRow(this)"><i class="fas fa-times"></i></button></td>
                    </tr>
                    {% endfor %}
                {% else %}
                    <tr>
                        <td>
                            <select class="form-select form-select-sm teacher-name-select" name="moderation_committee_name[]" onchange="onModerationNameChange(this)">
                                <option value="">Select Name</option>
                                {% for teacher in teachers %}
                                <option value="{{ teacher.name }}">{{ teacher.name }}</option>
                                {% endfor %}
                            </select>
                        </td>
                        <td><input type="text" class="form-control form-control-sm" name="moderation_committee_designation[]"></td>
                        <td><input type="text" class="form-control form-control-sm" name="moderation_committee_position[]"></td>
                        <td><button type="button" class="btn btn-remove-row" onclick="removeRow(this)"><i class="fas fa-times"></i></button></td>
                    </tr>
                {% endif %}
            </tbody>
        </table>
        <button type="button" class="btn btn-sm btn-primary btn-add-row" onclick="addModerationCommitteeRow()">Add Row</button>
    </div>
    
    <!-- Section 6: Sessional Assessment -->
    <div class="section-container">
        <div class="section-title">6. Sessional Assessment</div>
        <table id="table_sessional_assessment">
            <thead>
                <tr>
                    <th>Course No.</th>
                    <th>Name of the Teacher</th>
                    <th>No. of Students</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                {% if saved_data and saved_data.sessional_assessment %}
                    {% for item in saved_data.sessional_assessment %}
                    <tr>
                        <td>
                            <select class="form-select form-select-sm sessional-course-select" name="sessional_assessment_course[]" onchange="onSessionalCourseChange(this, 'sessional_assessment')">
                                <option value="">Select Course</option>
                            </select>
                        </td>
                        <td><input type="text" class="form-control form-control-sm" name="sessional_assessment_teacher[]" value="{{ item.teacher or '' }}"></td>
                        <td><input type="number" class="form-control form-control-sm" name="sessional_assessment_students[]" value="{{ item.students or '0' }}" min="0" readonly></td>
                        <td><button type="button" class="btn btn-remove-row" onclick="removeRow(this)"><i class="fas fa-times"></i></button></td>
                    </tr>
                    {% endfor %}
                {% else %}
                    <tr>
                        <td>
                            <select class="form-select form-select-sm sessional-course-select" name="sessional_assessment_course[]" onchange="onSessionalCourseChange(this, 'sessional_assessment')">
                                <option value="">Select Course</option>
                            </select>
                        </td>
                        <td><input type="text" class="form-control form-control-sm" name="sessional_assessment_teacher[]"></td>
                        <td><input type="number" class="form-control form-control-sm" name="sessional_assessment_students[]" value="0" min="0" readonly></td>
                        <td><button type="button" class="btn btn-remove-row" onclick="removeRow(this)"><i class="fas fa-times"></i></button></td>
                    </tr>
                {% endif %}
            </tbody>
        </table>
        <button type="button" class="btn btn-sm btn-primary btn-add-row" onclick="addSessionalAssessmentRow()">Add Row</button>
    </div>
    
    <!-- Section 7: Sessional Viva -->
    <div class="section-container">
        <div class="section-title">7. Sessional Viva</div>
        <table id="table_sessional_viva">
            <thead>
                <tr>
                    <th>Course No.</th>
                    <th>Name of the Teacher</th>
                    <th>No. of Students</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                {% if saved_data and saved_data.sessional_viva %}
                    {% for item in saved_data.sessional_viva %}
                    <tr>
                        <td>
                            <select class="form-select form-select-sm sessional-course-select" name="sessional_viva_course[]" onchange="onSessionalCourseChange(this, 'sessional_viva')">
                                <option value="">Select Course</option>
                            </select>
                        </td>
                        <td><input type="text" class="form-control form-control-sm" name="sessional_viva_teacher[]" value="{{ item.teacher or '' }}"></td>
                        <td><input type="number" class="form-control form-control-sm" name="sessional_viva_students[]" value="{{ item.students or '0' }}" min="0" readonly></td>
                        <td><button type="button" class="btn btn-remove-row" onclick="removeRow(this)"><i class="fas fa-times"></i></button></td>
                    </tr>
                    {% endfor %}
                {% else %}
                    <tr>
                        <td>
                            <select class="form-select form-select-sm sessional-course-select" name="sessional_viva_course[]" onchange="onSessionalCourseChange(this, 'sessional_viva')">
                                <option value="">Select Course</option>
                            </select>
                        </td>
                        <td><input type="text" class="form-control form-control-sm" name="sessional_viva_teacher[]"></td>
                        <td><input type="number" class="form-control form-control-sm" name="sessional_viva_students[]" value="0" min="0" readonly></td>
                        <td><button type="button" class="btn btn-remove-row" onclick="removeRow(this)"><i class="fas fa-times"></i></button></td>
                    </tr>
                {% endif %}
            </tbody>
        </table>
        <button type="button" class="btn btn-sm btn-primary btn-add-row" onclick="addSessionalVivaRow()">Add Row</button>
    </div>
    
    <!-- Section 8: Answer Script Scrutiny -->
    <div class="section-container">
        <div class="section-title">8. Answer Script Scrutiny</div>
        <table id="table_script_scrutiny">
            <thead>
                <tr>
                    <th>Name of the Scrutinizer</th>
                    <th>Designation/Institute</th>
                    <th>No. of Scripts</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                {% if saved_data and saved_data.script_scrutiny %}
                    {% for item in saved_data.script_scrutiny %}
                    <tr>
                        <td>
                            <select class="form-select form-select-sm teacher-name-select" name="script_scrutiny_name[]" onchange="onNameChange(this, 'script_scrutiny')">
                                <option value="">Select Name</option>
                                {% for teacher in teachers %}
                                <option value="{{ teacher.name }}" {% if item.name == teacher.name %}selected{% endif %}>{{ teacher.name }}</option>
                                {% endfor %}
                            </select>
                        </td>
                        <td><input type="text" class="form-control form-control-sm" name="script_scrutiny_designation[]" value="{{ item.designation or '' }}"></td>
                        <td><input type="number" class="form-control form-control-sm" name="script_scrutiny_scripts[]" value="{{ item.scripts or '0' }}" min="0"></td>
                        <td><button type="button" class="btn btn-remove-row" onclick="removeRow(this)"><i class="fas fa-times"></i></button></td>
                    </tr>
                    {% endfor %}
                {% else %}
                    <tr>
                        <td>
                            <select class="form-select form-select-sm teacher-name-select" name="script_scrutiny_name[]" onchange="onNameChange(this, 'script_scrutiny')">
                                <option value="">Select Name</option>
                                {% for teacher in teachers %}
                                <option value="{{ teacher.name }}">{{ teacher.name }}</option>
                                {% endfor %}
                            </select>
                        </td>
                        <td><input type="text" class="form-control form-control-sm" name="script_scrutiny_designation[]"></td>
                        <td><input type="number" class="form-control form-control-sm" name="script_scrutiny_scripts[]" value="0" min="0"></td>
                        <td><button type="button" class="btn btn-remove-row" onclick="removeRow(this)"><i class="fas fa-times"></i></button></td>
                    </tr>
                {% endif %}
            </tbody>
        </table>
