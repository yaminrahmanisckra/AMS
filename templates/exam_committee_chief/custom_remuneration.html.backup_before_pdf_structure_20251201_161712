    saveBtn.disabled = true;
    saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Generating PDF...';
    
    fetch('/exam-committee-chief/custom-remuneration/export-pdf', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify(formData)
    })
    .then(response => {
        if (!response.ok) throw new Error('PDF generation failed');
        return response.blob();
    })
    .then(blob => {
        const url = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'Remuneration_Statement.pdf';
        document.body.appendChild(a);
        a.click();
        window.URL.revokeObjectURL(url);
        document.body.removeChild(a);
        saveBtn.disabled = false;
        saveBtn.innerHTML = originalText;
    })
    .catch(error => {
        console.error('Error exporting PDF:', error);
        alert('Error exporting PDF: ' + error.message);
        saveBtn.disabled = false;
        saveBtn.innerHTML = originalText;
    });
}

// Auto-load from localStorage and URL on page load
document.addEventListener('DOMContentLoaded', function() {
    // Check for saved draft in localStorage
    const savedDraft = localStorage.getItem('custom_remuneration_draft');
    if (savedDraft) {
        const timestamp = localStorage.getItem('custom_remuneration_draft_timestamp');
        const savedDate = timestamp ? new Date(timestamp) : null;
        const hoursAgo = savedDate ? (Date.now() - savedDate.getTime()) / (1000 * 60 * 60) : 0;
        
        if (hoursAgo < 24) { // Only restore if less than 24 hours old
            const confirmRestore = confirm(
                `You have unsaved changes from ${savedDate ? savedDate.toLocaleString() : 'recently'}.\n\n` +
                'Would you like to restore them?'
            );
            
            if (confirmRestore) {
                try {
                    const draftData = JSON.parse(savedDraft);
                    populateFormData(draftData);
                    console.log('✅ Draft data restored from localStorage');
                } catch (error) {
                    console.error('❌ Error restoring draft:', error);
                }
            }
        }
    }
    
    // Check for form_id in URL
    const urlParams = new URLSearchParams(window.location.search);
    const pathParts = window.location.pathname.split('/');
    const formIdFromUrl = urlParams.get('form_id') || (pathParts[pathParts.length - 1] && /^\d+$/.test(pathParts[pathParts.length - 1]) ? pathParts[pathParts.length - 1] : null);
    
    if (formIdFromUrl && /^\d+$/.test(formIdFromUrl)) {
        fetch(`/exam-committee-chief/custom-remuneration/load/${formIdFromUrl}`)
            .then(response => response.json())
            .then(data => {
                if (data.success && data.data) {
                    populateFormData(data.data);
                    console.log('✅ Form data loaded from server');
                }
            })
            .catch(error => {
                console.error('❌ Error loading form data:', error);
            });
    }
    
    // If saved_data is passed from backend (not from URL)
    {% if saved_data %}
    if (!formIdFromUrl) {
        populateFormData({{ saved_data|tojson }});
    }
    {% endif %}
    
    // Auto-load courses on initial page load
    setTimeout(async () => {
        await autoLoadCoursesForTables();
    }, 1000);
});

</script>
{% endblock %}