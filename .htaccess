# Passenger Configuration
PassengerEnabled On
PassengerAppRoot "/home/gronthon/kulawams.xyz"
PassengerAppType wsgi
PassengerStartupFile passenger_wsgi.py
PassengerPython "/home/gronthon/virtualenv/kulawams.xyz/3.12/bin/python"
# SetEnv causes 500 on this host now - set in .env or cPanel env vars if needed
# SetEnv CPANEL 1
# SetEnv FLASK_ENV production
# SetEnv DOMAIN kulawams.xyz
# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>
Options -Indexes
AddDefaultCharset UTF-8
# Protect sensitive files
<FilesMatch "^(\.env|\.git|requirements\.txt|\.pyc|passenger_wsgi\.py)$">
    Order allow,deny
    Deny from all
</FilesMatch>
# DO NOT REMOVE OR MODIFY. CLOUDLINUX ENV VARS CONFIGURATION BEGIN
<IfModule Litespeed>
SetEnv Mail_SERVER localhost
SetEnv MAIL_USERNAME recovery@kulawams.xyz
SetEnv MAIL_DEFAULT_SENDER recovery@kulawams.xyz
SetEnv MAIL_USE_TLS False
SetEnv MAIL_USE_SSL False
SetEnv MAIL_PORT 25
SetEnv MAIL_PASSWORD 24010905iI
</IfModule>
# DO NOT REMOVE OR MODIFY. CLOUDLINUX ENV VARS CONFIGURATION END

# php -- BEGIN cPanel-generated handler, do not edit
# Set the "ea-php80" package as the default "PHP" programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php80 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
